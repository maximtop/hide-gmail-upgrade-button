{
    "name": "hide-gmail-upgrade-button",
    "version": "0.2.0",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@11.18.0",
    "description": "Hides Upgrade and Ask Gemini in Gmail, Drive, and Docs, plus Upgrade in Google Calendar",
    "license": "MIT",
    "author": "Maxim Topciu [maximtop] <me@maximtop.dev>",
    "homepage": "https://github.com/maximtop/hide-gmail-upgrade-button#readme",
    "repository": {
        "type": "git",
        "url": "https://github.com/maximtop/hide-gmail-upgrade-button.git"
    },
    "bugs": {
        "url": "https://github.com/maximtop/hide-gmail-upgrade-button/issues"
    },
    "engines": {
        "node": ">=24 <25"
    },
    "scripts": {
        "dev": "CHANNEL_ENV=dev tsx scripts/build/bundle.ts",
        "release": "CHANNEL_ENV=release tsx scripts/build/bundle.ts",
        "build": "pnpm release",
        "icons": "tsx scripts/icons/generate.ts",
        "store:assets": "tsx scripts/store/assets.ts",
        "store:descriptions": "tsx scripts/store/convert-descriptions.ts",
        "test": "vitest run",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit",
        "check": "pnpm test && pnpm lint && pnpm typecheck",
        "validate": "pnpm check"
    },
    "devDependencies": {
        "@rspack/core": "^2.1.5",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/adm-zip": "^0.5.8",
        "@types/chrome": "^0.2.2",
        "@types/node": "^24.13.3",
        "adm-zip": "^0.5.18",
        "eslint": "^10.8.0",
        "eslint-plugin-jsdoc": "^63.3.1",
        "happy-dom": "^20.11.1",
        "sharp": "^0.35.3",
        "tsx": "^4.23.1",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.65.0",
        "vitest": "^4.1.10"
    }
}
